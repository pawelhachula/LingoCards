rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Sprawdzenie czy zalogowany użytkownik ma rolę admina
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Główne metadane użytkownika są publiczne dla zalogowanych (dla rankingu), ale prywatne podkolekcje są chronione
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      match /data/{document=**} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
      match /notifications/{document=**} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }

    // Globalna konfiguracja systemu (np. czy pokazywać boty)
    match /config/system {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Powiadomienia administracyjne
    match /admin_notifications/{document=**} {
      allow read, update, delete: if isAdmin();
      allow create: if request.auth != null;
    }
  }
}
